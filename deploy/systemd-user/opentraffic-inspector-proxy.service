# Forwards the public port to the inspector on loopback :8088, starting
# it first. --exit-idle-time stops the proxy once no connection has been
# open for 15 minutes; the inspector (StopWhenUnneeded) stops with it.
# Needs systemd 246+ (JetPack 6); on JetPack 5 drop the flag.
#
# BindsTo, not Requires: if the inspector stops or crashes, the proxy
# stops with it, and the next connection starts both again. With
# Requires the proxy would stay up forwarding to nothing.

[Unit]
Description=OpenTraffic inspector (on-demand) - proxy
BindsTo=opentraffic-inspector.service
After=opentraffic-inspector.service

[Service]
ExecStart=/lib/systemd/systemd-socket-proxyd --exit-idle-time=15min 127.0.0.1:8088
NoNewPrivileges=yes
