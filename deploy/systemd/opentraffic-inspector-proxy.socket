# The inspector's public port. systemd holds it open at all times and
# costs nothing while nobody connects; the first connection starts
# opentraffic-inspector-proxy.service.

[Unit]
Description=OpenTraffic inspector (on-demand) - listening socket

[Socket]
ListenStream=8080
# Keep the listener up across proxy restarts.
Accept=no

[Install]
WantedBy=sockets.target
